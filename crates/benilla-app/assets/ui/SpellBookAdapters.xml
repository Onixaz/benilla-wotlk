<Ui>
    <!--
        Deviation: the pet page's autocastable overlay takes the pet bar button's proportions,
        so its corner brackets sit on the button's edge. Stock SpellBookFrame.xml:126 has it 60
        on a 37 button; the pet bar's is 58 on 30 (PetActionBarFrame.xml:10), and 71.53 is
        37 x 58/30. The autocast sparkle, a SpellBookShineTemplate frame placed per button by
        SpellButton_UpdateButton, stays stock.
    -->
    <Script><![CDATA[
        for i = 1, 12 do
            local overlay = _G["SpellButton" .. i .. "AutoCastable"]
            overlay:SetWidth(71.53)
            overlay:SetHeight(71.53)
        end
    ]]></Script>
</Ui>
